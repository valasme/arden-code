{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arden Code",
  "mainBinaryName": "arden-code",
  "identifier": "io.github.valasme.arden",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && cargo build --release -p arden-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Arden Code",
        "width": 1280,
        "height": 800,
        "minWidth": 500,
        "minHeight": 560,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1MEJGNjJGODIyMzAxMjUKUldRbEFTT0NML1lMQlI2clM2SVFGaGhzWVJGOW1GOHdWNlpQaUxpTWpDa3RIY3Q3c29FdmcwdlYK",
      "endpoints": ["https://github.com/valasme/arden-code/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "valasme",
    "copyright": "MIT license",
    "category": "DeveloperTool",
    "shortDescription": "A Windows desktop app for working with Claude Code and Codex",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "customLanguageFiles": { "English": "installer/English.nsh" },
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
