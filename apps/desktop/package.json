{
  "name": "@arden/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:e2e:release": "node e2e/run-release.mjs",
    "test:perf": "node e2e/run-performance.mjs",
    "test:e2e:installer": "playwright test e2e/installer.spec.ts --config playwright.installer.config.ts",
    "build:debug": "tauri build --debug --no-bundle --config src-tauri/tauri.debug.conf.json",
    "i18n:lint": "i18next-cli lint && i18next-cli extract --ci",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "build:web:debug": "vite build --mode debug"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "catalog:",
